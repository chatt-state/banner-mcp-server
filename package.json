{
  "name": "@chatt-state/banner-mcp-server",
  "version": "0.2.0",
  "type": "module",
  "description": "MCP server for Ellucian Banner — Ethos Integration and native Banner REST APIs",
  "author": "Aaron Sachs / Chattanooga State Community College",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "banner-mcp-server": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ && prettier --check \"src/**/*.ts\"",
    "lint:fix": "eslint src/ --fix && prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "github:chatt-state/banner-mcp-server"
  },
  "homepage": "https://github.com/chatt-state/banner-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/chatt-state/banner-mcp-server/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "keywords": [
    "mcp",
    "ellucian",
    "banner",
    "ethos",
    "model-context-protocol",
    "higher-education"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ellucian-banner": "file:../ellucian-banner",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.2.3",
    "eslint": "^10.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.0.18"
  }
}
