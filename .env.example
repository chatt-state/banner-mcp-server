# Banner MCP Server configuration. Copy to .env (never commit it) or set in
# your MCP client / secret store. All values below are placeholders.

# --- Ethos Integration (required) -------------------------------------------
# API key of a DEDICATED Ethos application for this server (see README,
# "Ethos API key setup").
ETHOS_API_KEY=
# Regional host if your tenant is not in the US. Must be https.
ETHOS_BASE_URL=https://integrate.elluciancloud.com
# Per-attempt timeout for Ethos/Banner requests, ms (1000-300000).
BANNER_REQUEST_TIMEOUT_MS=30000

# --- Banner native REST (optional) ------------------------------------------
# When all three are set, the read-only banner_api_get tool is registered.
BANNER_BASE_URL=
BANNER_USERNAME=
BANNER_PASSWORD=
# Path prefixes banner_api_get may read (comma list). Anything else on the
# Banner host (admin consoles, UI pages) is refused, so the service account's
# credentials only reach the REST APIs. Default:
# BANNER_API_PATH_PREFIXES=/StudentApi/api/,/BannerAdminBPAPI/api/
BANNER_API_PATH_PREFIXES=

# --- Tools ------------------------------------------------------------------
# Domains registered at startup: comma list of student,financial_aid,finance,hr,ethos
# or "all" (use for clients that ignore tools/list_changed) or "none".
BANNER_PRELOAD_DOMAINS=student
# Register banner_ethos_create/update/delete and banner_ethos_consume_notifications.
# Leave false unless you need writes; the server is read-only by default.
BANNER_ALLOW_WRITES=false
# Max characters per tool response (2000-5000000). Larger results are trimmed
# with an explicit truncation notice.
BANNER_MAX_RESPONSE_CHARS=60000
# One JSON line per tool call on stderr (PII-redacted). Keep enabled.
BANNER_AUDIT_LOG=true
# debug | info | warn | error
BANNER_LOG_LEVEL=info

# --- Transport --------------------------------------------------------------
# stdio (local MCP client) or http (remote, Streamable HTTP)
BANNER_MCP_TRANSPORT=stdio
BANNER_MCP_HTTP_HOST=127.0.0.1
BANNER_MCP_HTTP_PORT=3001
# Required for http: at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BANNER_MCP_HTTP_TOKEN=
# Optional Host header allow-list (DNS rebinding protection), e.g. banner-mcp.example.edu
BANNER_MCP_ALLOWED_HOSTS=
BANNER_MCP_MAX_SESSIONS=50
BANNER_MCP_SESSION_IDLE_MINUTES=30
